# Spider Swing — editor defaults.
#
# GDScript is tab-indented: that is the engine's own convention, the format the
# Godot editor writes, and what the official style guide specifies. Mixing
# spaces into .gd files produces noisy diffs when the editor rewrites a file.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

# Godot text-native resources: written by the engine with tabs.
[*.{gd,tscn,tres,godot,cfg}]
indent_style = tab
indent_size = 4

# Python tooling follows PEP 8.
[*.py]
indent_style = space
indent_size = 4
max_line_length = 100

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{json,jsonc}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
# Markdown uses trailing double-spaces for hard line breaks.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
