; Spider Swing — Godot project configuration.
;
; Engine: Godot 4.7.1 Standard (no .NET). Language: GDScript.
; Locked by docs/technical/adr/0001-engine-and-runtime.md.
;
; This file is text-native and hand-maintained. Values below are architectural
; contracts, not incidental editor state — tests/test_runner.gd asserts the
; physics tick rate, the main scene, and the input actions, so an accidental
; editor rewrite that drops them fails CI rather than silently changing feel.

config_version=5

[application]

config/name="Spider Swing"
config/description="Android-first 2D physics swing game. \"Spider Swing\" is an internal codename, not an approved release name — see docs/product/name-status.md."
config/version="0.0.0-bootstrap"
run/main_scene="res://game/bootstrap/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[debug]

gdscript/warnings/enable=true
gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_property_access=1

[display]

; Reference resolution is 1280x720. `canvas_items` + `expand` keeps the
; reference height authoritative while letting wider phone aspect ratios reveal
; more horizontal world — the extended horizontal view the GDD requires for
; reaction distance (GDD 4.1) rather than letterboxing it away.
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
; 0 = DisplayServer.SCREEN_LANDSCAPE. Landscape is a locked GDD rule (GDD 4.1).
window/handheld/orientation=0

[input]

; Phase 0 input surface only: these actions are DEFINED here so the router and
; the tests have a stable contract to bind to. No gameplay consumes them yet.
; Keyboard bindings are the desktop/CI development surface; touch bindings are
; added with the Phase 0 input router (see the Phase 0 issue), because touch
; needs the buffered-command seam described in docs/runtime_contracts.md, not a
; raw action poll.

web_action={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":32,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
reel_in={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194325,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194305,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
restart_run={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":82,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
toggle_debug={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194332,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[physics]

; Locked by ADR 0002. 60 Hz fixed simulation, at most 4 catch-up steps per
; rendered frame so a resume spike cannot fast-forward the simulation
; unboundedly (GDD 21).
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4
common/physics_interpolation=true
2d/default_gravity=980.0

[rendering]

; Compatibility renderer is a locked GDD/ADR decision: it is the widest
; Android GLES3 baseline and the cheapest 2D path.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
